rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads/writes unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidTask(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.description is string && data.description.size() <= 1000 &&
             data.priority in ['LOW', 'MEDIUM', 'HIGH'] &&
             data.category in ['PERSONAL', 'WORK', 'STUDY', 'OTHER'] &&
             data.status in ['PENDING', 'IN_PROGRESS', 'COMPLETED'] &&
             (!('dueDateMillis' in data) || (data.dueDateMillis is int && data.dueDateMillis >= 0)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/tasks/{taskId} {
      allow get: if isSignedIn() && isOwner(userId) && isValidId(taskId);
      allow list: if isSignedIn() && isOwner(userId);

      allow create: if isSignedIn() &&
                       isOwner(userId) &&
                       isValidId(taskId) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'description', 'priority',
                         'category', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'description', 'priority',
                         'category', 'status', 'dueDateMillis', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTask(incoming(), userId);

      allow update: if isSignedIn() &&
                       isOwner(userId) &&
                       isValidId(taskId) &&
                       isValidTask(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'description', 'priority', 'category',
                           'status', 'dueDateMillis', 'updatedAt'
                         ])
                       );

      allow delete: if isSignedIn() && isOwner(userId) && isValidId(taskId);
    }
  }
}
